# py_upper application configuration.
#
# This file is the tracked template. Copy it to app/pyproject.toml and edit the
# copy: the local file is Git-ignored, so your application name, dependencies
# and runtime choices stay on your machine while this template keeps tracking
# the repository.

[build-system]
requires = [
    "setuptools>=71,<72; python_version < '3.9'",
    "setuptools>=77; python_version >= '3.9'",
    "wheel",
    "Cython>=3.1,<3.3",
]
build-backend = "setuptools.build_meta"

[project]
name = "py_upper"
version = "0.17.6"
description = "py_upper standalone Python application"
requires-python = ">=3.8,<3.14"
# Runtime dependencies of your application, as requirement strings, e.g.
# "PySide6==6.11.0", "pyserial==3.5", "bleak==3.0.2", "qasync==0.28.0".
# The template ships none: a fork must not inherit the pins of whoever cloned
# first. Declare yours in the working copy; py_upper resolves the matching
# wheels for every target and installs them into the bundle.
dependencies = []

[tool.setuptools]
package-dir = {"" = "src"}

[tool.setuptools.packages.find]
where = ["src"]

[tool.py_upper]
entry = "main.py"

[tool.py_upper.app]
name = "MyApp"
identifier = "com.example.pyupper"

[tool.py_upper.runtime]
provider = "pbs"
# The oldest Python that python-build-standalone publishes for every target
# listed below. Windows on ARM starts at 3.11.13, so a 3.10 pin cannot cover
# [tool.py_upper.windows] architectures = ["x86", "x86_64", "arm64"].
python = "3.11.13"

[tool.py_upper.dependencies]
# PySide6 ships manylinux_2_34 (x86_64) and manylinux_2_39 (aarch64) wheels, so
# the Linux targets must accept those baselines. This sets the minimum glibc of
# the released Linux app; drop entries to target older distributions.
manylinux = ["manylinux_2_39", "manylinux_2_34"]

[tool.py_upper.native]
# PySide6 payload the bundle cannot honour, dropped instead of failing the
# closure:
#   - the macOS wheel links the ODBC/Mimer/PostgreSQL Qt SQL drivers against
#     build-machine absolute paths and references a QtQuickShapesDesignHelpers
#     framework it does not ship;
#   - the Windows wheels ship an ARM32 vccorlib140.dll, in the PySide6 and the
#     shiboken6 wheel alike. Windows on ARM cannot map an ARM32 image at all,
#     no image in either wheel imports it (it is the C++/CX runtime, which Qt
#     does not use), and leaving it in makes the payload arch guard reject the
#     whole windows-arm64 bundle.
exclude = [
    "PySide6/Qt/plugins/sqldrivers/*qsqlmimer*",
    "PySide6/Qt/plugins/sqldrivers/*qsqlodbc*",
    "PySide6/Qt/plugins/sqldrivers/*qsqlpsql*",
    "PySide6/Qt/qml/QtQuick/Shapes/DesignHelpers/*",
    "PySide6/vccorlib140.dll",
    "shiboken6/vccorlib140.dll",
]

[tool.py_upper.cython]
include = ["*"]
exclude = []

[tool.py_upper.build]
# 同时编译的模块数；0（默认）= 每 CPU 一个任务。
jobs = 0
# 复用内容未变化的模块的 Cython 产物与扩展；false = 每次全量重编译。
incremental = true

[tool.py_upper.optimize]
profile = "safe"
# Keep only the Qt modules app/src imports (plus their transitive closure).
# "all" ships every Qt module, including the ~450 MB QtWebEngine.
qt = "imports"
remove_python_caches = true
remove_tests = false
remove_docs = false
strip_native = false

[tool.py_upper.windows]
architectures = ["x86", "x86_64", "arm64"]

[tool.py_upper.macos]
architectures = ["arm64", "x86_64"]

[tool.py_upper.linux]
architectures = ["x86_64", "arm64"]
