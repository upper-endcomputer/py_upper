# py_upper application configuration.
#
# This file is the tracked template. Copy it to app/pyproject.toml and edit the
# copy: the local file is Git-ignored, so your application name, dependencies
# and runtime choices stay on your machine while this template keeps tracking
# the repository.

[build-system]
requires = [
    "setuptools>=71,<72; python_version < '3.9'",
    "setuptools>=77; python_version >= '3.9'",
    "wheel",
    "Cython>=3.1,<3.3",
]
build-backend = "setuptools.build_meta"

[project]
name = "py_upper"
version = "0.17.18"
description = "py_upper standalone Python application"
requires-python = ">=3.8,<3.14"
# Runtime dependencies of your application, as requirement strings, e.g.
# "PySide6==6.11.0", "pyserial==3.5", "bleak==3.0.2", "qasync==0.28.0".
# The template ships none: a fork must not inherit the pins of whoever cloned
# first. Declare yours in the working copy; py_upper resolves the matching
# wheels for every target and installs them into the bundle.
dependencies = []

[tool.setuptools]
package-dir = {"" = "src"}

[tool.setuptools.packages.find]
where = ["src"]

[tool.py_upper]
entry = "main.py"

[tool.py_upper.app]
# APP NAME, single source of truth: derives the .app / executable /
# Info.plist / Windows version-resource names and is compiled into the
# launcher as PY_UPPER_APP_NAME. Change this line and rebuild
# (python tools/build.py --clean); see README "App 名称".
name = "Upper"
identifier = "com.example.pyupper"

[tool.py_upper.runtime]
provider = "pbs"
# Windows PBS builds use the official python.org embeddable ZIP as runtime
# and the matching PBS full SDK only for compiling. This exact version is
# available as all three Windows embeddable ZIPs and across all seven PBS SDKs.
# Python 3.11.13 is PBS-only: python.org has no 3.11.13 embeddable ZIP.
python = "3.13.5"

[tool.py_upper.dependencies]
# PySide6 ships manylinux_2_34 (x86_64) and manylinux_2_39 (aarch64) wheels, so
# the Linux targets must accept those baselines. This sets the minimum glibc of
# the released Linux app; drop entries to target older distributions.
manylinux = ["manylinux_2_39", "manylinux_2_34"]

[tool.py_upper.native]
# PySide6 payload the bundle cannot honour, dropped instead of failing the
# closure:
#   - the macOS wheel links the ODBC/Mimer/PostgreSQL Qt SQL drivers against
#     build-machine absolute paths and references a QtQuickShapesDesignHelpers
#     framework it does not ship;
#   - the Windows wheels ship an ARM32 vccorlib140.dll, in the PySide6 and the
#     shiboken6 wheel alike. Windows on ARM cannot map an ARM32 image at all,
#     no image in either wheel imports it (it is the C++/CX runtime, which Qt
#     does not use), and leaving it in makes the payload arch guard reject the
#     whole windows-arm64 bundle;
#   - the win_amd64 wheels also ship a 32-bit ucrtbase.dll, again in the
#     PySide6 and the shiboken6 wheel alike. The UCRT belongs to Windows: it is
#     on the closure's host-library list (native/deps.py), so it is never
#     resolved and copied, the loader takes it from System32, and no bundled
#     image can map this copy. Leaving it in makes the arch guard reject the
#     whole x86_64 bundle.
exclude = [
    # macOS and Windows wheels use different PySide6 plugin/qml prefixes, and
    # these optional SQL/design payloads cannot be bundled.
    "PySide6/plugins/sqldrivers/*qsqlibase*",
    "PySide6/plugins/sqldrivers/*qsqlmimer*",
    "PySide6/plugins/sqldrivers/*qsqlodbc*",
    "PySide6/plugins/sqldrivers/*qsqloci*",
    "PySide6/plugins/sqldrivers/*qsqlpsql*",
    "PySide6/qml/QtQuick/Shapes/DesignHelpers/*",
    "PySide6/Qt/plugins/sqldrivers/*qsqlmimer*",
    "PySide6/Qt/plugins/sqldrivers/*qsqlodbc*",
    "PySide6/Qt/plugins/sqldrivers/*qsqlpsql*",
    "PySide6/Qt/qml/QtQuick/Shapes/DesignHelpers/*",
    "PySide6/ucrtbase.dll",
    "PySide6/vccorlib140.dll",
    "shiboken6/ucrtbase.dll",
    "shiboken6/vccorlib140.dll",
]

[tool.py_upper.egg]
# Pack the application's own Python modules and the extensions this build
# produced into one encrypted bundle/py_upper.dat. This raises the cost of reading the
# shipped code; it is obfuscation, not strong cryptography, and it barely
# changes the bundle size. Use [tool.py_upper.trim] and Qt pruning for size.
# Encryption is the default; pass --no-egg for a loose-file build.
enabled = true
# SHAKE-256 key stream key: at least 16 bytes of hexadecimal. It is compiled
# into the launcher, so it is obfuscation material, not a secret. Changing it
# requires rebuilding everything that reads the archive.
key_hex = "047636cf3ddbaae2346f597256416e858ee0b7c8b7448221e5babfbb4f74c20d"
# auto: map extensions from memory on Windows when _memimporter is available,
#       otherwise decrypt into a private temporary directory.
# memory: force the Windows in-memory path (needs the Zig toolchain).
# extract: decrypt into a temporary directory and add it to sys.path.
backend = "auto"
# deflated | stored | lzma
compression = "deflated"

[tool.py_upper.cython]
include = ["*"]
exclude = []

[tool.py_upper.build]
# 同时编译的模块数；0（默认）= 每 CPU 一个任务。
jobs = 0
# 复用内容未变化的模块的 Cython 产物与扩展；false = 每次全量重编译。
incremental = true

[tool.py_upper.optimize]
profile = "safe"
# Keep only the Qt modules app/src imports (plus their transitive closure).
# "all" ships every Qt module, including the ~450 MB QtWebEngine.
qt = "imports"
# Optional Qt payload cuts. They are commented out so the template keeps the
# conservative default; each one is safe for an application that does not use
# the payload it removes:
#   qt_software_opengl = false
#       drop opengl32sw.dll (~20 MB). Keep true if the app must start on a
#       machine without a usable OpenGL driver.
#   qt_locales = ["zh_CN"]
#       keep only these Qt translations (an exact locale, or a bare language
#       that also matches its regional variants). "all" keeps every wheel file.
#   qt_image_formats = ["gif", "ico", "jpeg", "svg"]
#       keep only these image/icon plugins. PNG is built into QtGui. A list
#       without "svg" also drops the SVG icon engine and Qt5Svg/Qt6Svg.
#   qt_platforms = ["windows", "cocoa", "xcb", "wayland", "offscreen"]
#       keep only these platform plugins; one list covers Windows, Linux and
#       macOS wheels. "all" keeps every platform Qt ships.
qt_software_opengl = true
qt_locales = "all"
qt_image_formats = "all"
qt_platforms = ["windows", "cocoa", "xcb", "wayland", "offscreen"]
remove_python_caches = true
remove_tests = false
remove_docs = false
strip_native = false

[tool.py_upper.trim]
# 全局规则由代码内置，任何 preset 和配置都会生效：
#   site-packages: **/*.dist-info、**/*.egg-info、**/*.pyi、
#                  PySide*/PyQt* 的 examples/include；
#   runtime:       **/idlelib、**/test、**/tests、**/include、**/pkgconfig。
# 这里只写这个项目额外要删的路径。`*_keep` 优先于全局规则，确实要保留
# importlib.metadata 数据或 Tk 时，用 keep 把对应路径保护起来。
# 预设："safe"（默认）只使用全局规则和下面的规则；"release" 是兼容别名
# （安装元数据已经是全局规则）；"minimal" 再移除 opengl32sw.dll、
# qdirect2d/qminimal 平台插件、Qt 翻译和 WebP/TIFF 图片插件。minimal 用
# `**/` 同时覆盖 Windows 平铺、PySide6/Qt、PyQt5/Qt5 和 PyQt6/Qt6 布局；
# 它需要目标机器有可用的 OpenGL 驱动，且应用不依赖这些可选插件/翻译。
# 也可以在单次构建时选择：python tools/build.py --trim-preset minimal
preset = "safe"
# 打包后从 site-packages / runtime 里删除的路径。glob 相对各自的根目录：
# `*`、`?`、`[]` 不跨目录，`**` 可以跨目录；匹配到目录时整棵子树都会删除。
# 单次构建也可以临时追加，例如：
#   python tools/build.py --trim-site "PySide2/translations/*.qm"
site_packages = []
site_packages_keep = []

# Tk/Tcl 只在应用真的使用 Tk 时才需要，所以不放进全局规则。Qt 应用可以
# 取消注释；应用依赖某个包自带的 tests 目录时，用 runtime_keep 保回来。
runtime = [
  # "**/tkinter",
  # "**/tcl[0-9]*",
  # "**/tk[0-9]*",
  # "**/itcl[0-9]*",
  # "**/thread[0-9]*",
]
runtime_keep = []

[tool.py_upper.windows]
architectures = ["x86", "x86_64", "arm64"]

[tool.py_upper.macos]
architectures = ["arm64", "x86_64"]

[tool.py_upper.linux]
architectures = ["x86_64", "arm64"]
