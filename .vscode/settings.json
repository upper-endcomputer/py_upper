{
    "python.defaultInterpreterPath": "${workspaceFolder}/app/.venv",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/app/src"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "${workspaceFolder}/app/tests"
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true
    }
}
