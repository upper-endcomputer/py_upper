{
    "python.analysis.extraPaths": [
        "${workspaceFolder}/app/src"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "${workspaceFolder}/app/tests"
    ],
    "python-envs.workspaceSearchPaths": [
        "./**/.venv",
        "./**/venv",
        "./**/.env",
        "./**/env",
        "./**/.python",
        "./**/.conda"
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true
    },
    "search.exclude": {
        "**/build": true,
        "**/dist": true,
        "**/runtimes": true,
        "**/.cache": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/dist/**": true,
        "**/runtimes/**": true,
        "**/.cache/**": true
    }
}
